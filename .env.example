# ─────────────────────────────────────────────────────────────────────
# ICSMAMET 2027 — integration settings (all optional)
# Copy to `.env` for local use, or set these in the Vercel / Netlify
# dashboard. Leave a value empty until its destination is verified:
# the site then shows a clear "not yet open" state with an email fallback
# instead of a button that appears to work.
# ─────────────────────────────────────────────────────────────────────

# Public URL of the deployed site (used for canonical tags, sitemap,
# social previews). On Netlify (URL) and Vercel (VERCEL_PROJECT_PRODUCTION_URL)
# this is detected automatically if left empty.
SITE_URL=

# Approved online registration form / institutional payment portal.
VITE_REGISTRATION_URL=

# Paper submission system (e.g. CMT, EasyChair, Conftool) once opened.
VITE_SUBMISSION_URL=

# Optional form endpoint that accepts JSON POSTs (e.g. Formspree, Getform,
# a Netlify/Vercel serverless function). If empty, the contact and
# accommodation forms open a pre-filled email to the conveners instead.
VITE_CONTACT_FORM_ENDPOINT=

# Official Google Maps share link for the venue (optional — a map search
# for the institute is used if empty).
VITE_MAP_URL=
